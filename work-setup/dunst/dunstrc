[global]
    monitor = 0
    follow = mouse
    width = 350
    height = 300
    origin = top-right
    offset = (16, 48)
    padding = 12
    horizontal_padding = 14
    gap_size = 8

    frame_width = 2
    frame_color = "#7aa2f7"
    separator_color = frame
    corner_radius = 10

    font = JetBrains Mono Nerd Font 11
    format = "<b>%s</b>\n%b"
    alignment = left

    icon_theme = Papirus-Dark
    enable_recursive_icon_lookup = true
    max_icon_size = 48

    mouse_left_click = do_action, close_current
    mouse_right_click = close_all

[urgency_low]
    background = "#1a1b26"
    foreground = "#565f89"
    frame_color = "#3b4261"
    timeout = 4

[urgency_normal]
    background = "#1a1b26"
    foreground = "#c0caf5"
    frame_color = "#7aa2f7"
    timeout = 6

[urgency_critical]
    background = "#1a1b26"
    foreground = "#c0caf5"
    frame_color = "#f7768e"
    timeout = 0
